{
  "name": "front",
  "version": "0.0.1",
  "license": "MIT",
  "private": false,
  "description": "Front de la App SovereingSchool",
  "keywords": [
    "angular",
    "front",
    "web-obs",
    "obs",
    "video",
    "audio",
    "broadcast",
    "live-streaming",
    "streaming",
    "web-component"
  ],
  "author": {
    "name": "Giacca90",
    "email": "giacca90mobile@protonmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/giacca90/sovereing-school/tree/main/front"
  },
  "scripts": {
    "dev": "clear && concurrently -k -n NG,PROXY -c green,blue \"NODE_TLS_REJECT_UNAUTHORIZED=0 ng serve --ssl --ssl-cert ./cert.pem --ssl-key ./key.pem --no-hmr\" \"node proxy-dev.js\"",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run license-report",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "coverage": "ng test --code-coverage",
    "serve:ssr:front": "node dist/front/server/server.mjs",
    "lint": "ng lint",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "license-report": "license-checker --txt --out THIRD-PARTY-LICENSES.txt && sed -i \"s|$PWD|.|g\" THIRD-PARTY-LICENSES.txt"
  },
  "dependencies": {
    "@angular/animations": "22.2.1",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-browser-dynamic": "22.2.1",
    "@angular/platform-server": "22.2.1",
    "@angular/router": "22.2.1",
    "@angular/ssr": "22.2.1",
    "@stomp/stompjs": "7.3.0",
    "@videojs/http-streaming": "3.17.5",
    "axios": "1.20.0",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "jsonwebtoken": "9.0.3",
    "rxjs": "7.8.2",
    "sockjs-client": "1.6.1",
    "swiper": "14.3.0",
    "tslib": "2.8.1",
    "uuid": "14.0.2",
    "video.js": "8.24.1",
    "videojs-contrib-quality-levels": "4.1.0",
    "videojs-http-source-selector": "1.1.6",
    "web-obs": "0.0.17",
    "zone.js": "0.16.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular-eslint/eslint-plugin": "22.5.0",
    "@angular-eslint/eslint-plugin-template": "22.5.0",
    "@angular-eslint/schematics": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@tailwindcss/postcss": "4.2.2",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jasmine": "6.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.6.0",
    "@types/video.js": "7.3.58",
    "@typescript-eslint/eslint-plugin": "8.58.1",
    "@typescript-eslint/parser": "8.58.1",
    "autoprefixer": "10.4.27",
    "concurrently": "9.2.1",
    "eslint": "10.2.0",
    "http-proxy": "1.18.1",
    "http-proxy-middleware": "4.2.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "6.1.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.3.0",
    "license-checker": "^25.0.1",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwind-scrollbar": "4.0.2",
    "tailwindcss": "4.3.3",
    "terser": "^5.51.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@angular-devkit/build-angular": {
      "tailwindcss": "4.3.3"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
